# ===== REQUIRED =====

# Database (uses Docker service name "postgres", not localhost)
DB_PASSWORD=CHANGE_ME_to_a_strong_password
DATABASE_URL=postgresql+asyncpg://bot:${DB_PASSWORD}@postgres:5432/trading_bot
REDIS_URL=redis://redis:6379/0

# ===== TELEGRAM (recommended for VPS monitoring) =====
# 1. Message @BotFather on Telegram, send /newbot, follow prompts
# 2. Copy the bot token here
# 3. Message your new bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Find your chat_id in the response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== DASHBOARD =====
# Password to access the web dashboard at http://YOUR_IP:8000/
# Leave empty for no password (not recommended on a public VPS)
DASHBOARD_PASSWORD=

# ===== OPTIONAL =====

# Trading Mode (true = paper trading, false = live — DO NOT change until ready)
PAPER_TRADING=true

# API port (default 8000)
API_PORT=8000

# Risk Parameters (override config.yaml defaults)
# TOTAL_BUDGET=10000
# DAILY_LOSS_LIMIT_PCT=3
# WEEKLY_LOSS_LIMIT_PCT=7
# CASH_RESERVE_PCT=20

# ===== PHASE 3: LIVE BROKER KEYS (not needed for paper trading) =====
# BINANCE_API_KEY=
# BINANCE_SECRET=
# BINANCE_TESTNET=true
# ALPACA_API_KEY=
# ALPACA_SECRET=
# ALPACA_PAPER=true
# IB_HOST=127.0.0.1
# IB_PORT=4002
# IB_CLIENT_ID=1
